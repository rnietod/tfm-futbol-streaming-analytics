config {
  type: "table"
  , schema: "marts_football"
  , description: "Perfil estadístico histórico de jugadores por temporada, incluyendo métricas relativas al equipo."
  , tags: ["marts"]
  , bigquery: {
      clusterBy: ["player_id", "season"]
  }
}

with

  -- 1. Base de Eventos (Filtrada para juego activo)
  base_events as (
    select 
      match_id
      , season
      , league
      , team_id
      , player_id
      , player_name
      , type_id
      , outcome
      , is_key_pass
      , is_assist
      , is_big_chance
      , is_yellow_card
      , is_red_card
      , is_foul
      , field_zone
      , minute
    from ${ref("fct_events_enriched")}
    where period_id in (1, 2)
  )

  -- 2. Totales por EQUIPO y Temporada (El Contexto)
  , team_season_stats as (
    select
      team_id
      , season
      , league
      , countif(type_id = 16) as team_total_goals
      , countif(type_id in (13, 14, 15, 16)) as team_total_shots
      , countif(type_id = 1) as team_total_passes
    from base_events
    group by 1, 2, 3
  )

  -- 3. Totales por JUGADOR y Temporada
  , player_season_stats as (
    select
      player_id
      , player_name
      , team_id -- Asumimos equipo principal o último
      , season
      , league
      , count(distinct match_id) as matches_played
      
      -- Métricas Absolutas
      , countif(type_id = 16) as goals
      , countif(type_id in (13, 14, 15, 16)) as shots_total
      , countif(type_id in (14, 15, 16)) as shots_on_target -- Asumiendo 13=Miss
      , countif(type_id = 1) as passes_total
      , countif(type_id = 1 and outcome = 1) as passes_complete
      , countif(is_key_pass) as key_passes
      , countif(is_assist) as assists
      
      -- Defensa
      , countif(type_id = 7) as tackles
      , countif(type_id = 8) as interceptions
      , countif(type_id = 49) as recoveries
      
    from base_events
    where player_id is not null
    group by 1, 2, 3, 4, 5
  )

  -- 4. Cruce y Cálculo de Métricas Relativas
  , final as (
    select
      player_season_stats.*
      
      -- Eficiencia (Ratios)
      , safe_divide(player_season_stats.goals, player_season_stats.shots_total) as conversion_rate
      , safe_divide(player_season_stats.shots_on_target, player_season_stats.shots_total) as shooting_accuracy
      , safe_divide(player_season_stats.passes_complete, player_season_stats.passes_total) as pass_accuracy
      
      -- Relatividad (% del equipo)
      , safe_divide(player_season_stats.goals, team_season_stats.team_total_goals) as share_of_team_goals
      , safe_divide(player_season_stats.shots_total, team_season_stats.team_total_shots) as share_of_team_shots
      , safe_divide(player_season_stats.passes_total, team_season_stats.team_total_passes) as share_of_team_passes

    from
      player_season_stats
      left join team_season_stats 
        on player_season_stats.team_id = team_season_stats.team_id 
        and player_season_stats.season = team_season_stats.season
  )

select * from final