config {
  type: "table"
  , schema: "marts_football"
  , description: "Perfil estadístico avanzado de jugadores por temporada y contexto (Game State)."
  , tags: ["marts"]
  , bigquery: {
      clusterBy: ["player_id", "season", "game_state_label"]
  }
}

with

  -- 1. Base de Eventos
  base_events as (
    select 
      match_id
      , season
      , league
      , team_id
      , player_id
      , player_name
      , type_id
      , outcome
      , is_key_pass
      , is_assist
      , game_state_label
    from ${ref("fct_events_enriched")}
    where period_id in (1, 2)
  )

  -- 2. Totales por EQUIPO, Temporada y Game State
  , team_context as (
    select
      base_events.team_id
      , base_events.season
      , base_events.league
      , base_events.game_state_label
      , count(distinct base_events.match_id) as team_matches
      , countif(base_events.type_id = 16) as team_goals
      , countif(base_events.type_id in (13, 14, 15, 16)) as team_shots
      , countif(base_events.type_id = 1) as team_passes
    from base_events
    group by 
      base_events.team_id
      , base_events.season
      , base_events.league
      , base_events.game_state_label
  )

  -- 3. Totales por JUGADOR, Temporada y Game State
  , player_context as (
    select
      base_events.player_id
      , base_events.player_name
      , base_events.team_id
      , base_events.season
      , base_events.league
      , base_events.game_state_label
      , count(distinct base_events.match_id) as matches_played
      
      , countif(base_events.type_id = 16) as goals
      , countif(base_events.type_id in (13, 14, 15, 16)) as shots_total
      , countif(base_events.type_id in (14, 15, 16)) as shots_on_target
      , countif(base_events.type_id = 1) as passes_total
      , countif(base_events.type_id = 1 and base_events.outcome = 1) as passes_complete
      
    from base_events
    where base_events.player_id is not null
    group by 
      base_events.player_id
      , base_events.player_name
      , base_events.team_id
      , base_events.season
      , base_events.league
      , base_events.game_state_label
  )

  -- 4. Cruce Final
  , final as (
    select
      player_context.*
      
      -- Eficiencia (Ratios)
      , safe_divide(player_context.goals, player_context.shots_total) as conversion_rate
      , safe_divide(player_context.shots_on_target, player_context.shots_total) as shooting_accuracy
      , safe_divide(player_context.passes_complete, player_context.passes_total) as pass_accuracy
      
      -- Relatividad (% del Equipo en ese contexto)
      , safe_divide(player_context.goals, team_context.team_goals) as share_of_team_goals
      , safe_divide(player_context.shots_total, team_context.team_shots) as share_of_team_shots
      , safe_divide(player_context.passes_total, team_context.team_passes) as share_of_team_passes

    from
      player_context
      left join team_context 
        on player_context.team_id = team_context.team_id 
        and player_context.season = team_context.season
        and player_context.game_state_label = team_context.game_state_label
  )

select * from final