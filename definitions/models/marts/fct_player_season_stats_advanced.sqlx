config {
  type: "table"
  , schema: "marts_football"
  , description: "Perfil estadístico avanzado de jugadores por temporada y contexto (Game State). Incluye métricas relativas al equipo y ratios de eficiencia."
  , tags: ["marts"]
  , bigquery: {
      clusterBy: ["player_id", "season", "game_state_label"]
  }
}

with

  -- 1. Base de Eventos (Filtrada para juego activo y con Game State)
  base_events as (
    select 
      match_id
      , season
      , league
      , team_id
      , player_id
      , player_name
      , type_id
      , outcome
      , is_key_pass
      , is_assist
      , is_big_chance
      , is_yellow_card
      , is_red_card
      , is_foul
      , field_zone
      , game_state_label
      , minute
    from ${ref("fct_events_enriched")}
    where period_id in (1, 2)
  )

  -- 2. Totales por EQUIPO, Temporada y Game State (El Contexto)
  , team_context as (
    select
      team_id
      , season
      , league
      , game_state_label
      , count(distinct match_id) as team_matches
      , countif(type_id = 16) as team_goals
      , countif(type_id in (13, 14, 15, 16)) as team_shots
      , countif(type_id = 1) as team_passes
    from base_events
    group by 1, 2, 3, 4
  )

  -- 3. Totales por JUGADOR, Temporada y Game State
  , player_stats as (
    select
      player_id
      , player_name
      , team_id -- Asumimos equipo principal
      , season
      , league
      , game_state_label
      , count(distinct match_id) as matches_played
      
      -- Métricas Absolutas
      , countif(type_id = 16) as goals
      , countif(type_id in (13, 14, 15, 16)) as shots_total
      , countif(type_id in (14, 15, 16)) as shots_on_target -- Asumiendo 13=Miss
      , countif(type_id = 1) as passes_total
      , countif(type_id = 1 and outcome = 1) as passes_complete
      , countif(is_key_pass) as key_passes
      , countif(is_assist) as assists
      
      -- Defensa
      , countif(type_id = 7) as tackles
      , countif(type_id = 8) as interceptions
      , countif(type_id = 49) as recoveries
      
    from base_events
    where player_id is not null
    group by 1, 2, 3, 4, 5, 6
  )

  -- 4. Cruce y Cálculo de Métricas Relativas
  , final as (
    select
      player_stats.*
      
      -- Eficiencia (Ratios)
      , safe_divide(player_stats.goals, player_stats.shots_total) as conversion_rate
      , safe_divide(player_stats.shots_on_target, player_stats.shots_total) as shooting_accuracy
      , safe_divide(player_stats.passes_complete, player_stats.passes_total) as pass_accuracy
      
      -- Relatividad (% del equipo en ese contexto)
      , safe_divide(player_stats.goals, team_context.team_goals) as share_of_team_goals
      , safe_divide(player_stats.shots_total, team_context.team_shots) as share_of_team_shots
      , safe_divide(player_stats.passes_total, team_context.team_passes) as share_of_team_passes

    from
      player_stats
      left join team_context 
        on player_stats.team_id = team_context.team_id 
        and player_stats.season = team_context.season
        and player_stats.game_state_label = team_context.game_state_label
  )

select * from final