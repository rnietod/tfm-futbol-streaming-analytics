config {
  type: "table",
  schema: "marts_football",
  description: "Perfil unificado para Player Card. Agrega métricas ponderadas por recencia (Weighted Average) y calcula percentiles (Benchmarking) para jugadores y porteros.",
  tags: ["marts", "dashboard"]
}

WITH 
  -- 1. IDENTIFICAR TEMPORADA ACTUAL
  season_weights AS (
    SELECT 
      season,
      GREATEST(0.2, 1.0 - (RANK() OVER (ORDER BY season DESC) - 1) * 0.2) as recency_weight
    FROM (
      SELECT DISTINCT season FROM ${ref("fct_player_season_profile")}
    )
  ),

  -- 2. PROCESAMIENTO JUGADORES DE CAMPO
  field_weighted AS (
    SELECT
      p.player_id,
      ANY_VALUE(p.player_name) as player_name,
      ANY_VALUE(p.team_id) as current_team_id,
      'Field Player' as player_type,

      -- Métricas Ponderadas Campo
      SAFE_DIVIDE(SUM(COALESCE(p.goals_p30, 0) * w.recency_weight), SUM(w.recency_weight)) as w_goals_p30,
      SAFE_DIVIDE(SUM(COALESCE(p.xg_p30, 0) * w.recency_weight), SUM(w.recency_weight)) as w_xg_p30,
      SAFE_DIVIDE(SUM(COALESCE(p.shots_p30, 0) * w.recency_weight), SUM(w.recency_weight)) as w_shots_p30,
      SAFE_DIVIDE(SUM(COALESCE(p.key_passes_p30, 0) * w.recency_weight), SUM(w.recency_weight)) as w_key_passes_p30,
      SAFE_DIVIDE(SUM(COALESCE(p.passes_vertical_p30, 0) * w.recency_weight), SUM(w.recency_weight)) as w_progressive_p30,
      SAFE_DIVIDE(SUM(COALESCE(p.dribble_success_pct, 0.0) * w.recency_weight), SUM(w.recency_weight)) as w_dribble_pct,
      SAFE_DIVIDE(SUM(COALESCE(p.interceptions_p30, 0) * w.recency_weight), SUM(w.recency_weight)) as w_interceptions_p30,
      SAFE_DIVIDE(SUM(COALESCE(p.recoveries_p30, 0) * w.recency_weight), SUM(w.recency_weight)) as w_recoveries_p30

    FROM ${ref("fct_player_season_profile")} p
    JOIN season_weights w ON p.season = w.season
    GROUP BY p.player_id
  ),

  -- 3. PROCESAMIENTO PORTEROS
  gk_weighted AS (
    SELECT
      g.player_id,
      ANY_VALUE(g.player_name) as player_name,
      ANY_VALUE(g.team_id) as current_team_id,
      'Goalkeeper' as player_type,

      -- Métricas GK Ponderadas
      SAFE_DIVIDE(SUM(COALESCE(g.saves, 0) * w.recency_weight), SUM(w.recency_weight)) as w_saves_vol,
      SAFE_DIVIDE(SUM(COALESCE(g.saves_reflex, 0) * w.recency_weight), SUM(w.recency_weight)) as w_reflex_saves,
      SAFE_DIVIDE(SUM(COALESCE(g.long_pass_share, 0.0) * w.recency_weight), SUM(w.recency_weight)) as w_long_dist_share,
      SAFE_DIVIDE(SUM(COALESCE(g.distribution_accuracy, 0.0) * w.recency_weight), SUM(w.recency_weight)) as w_dist_accuracy

    FROM ${ref("fct_goalkeeper_season_profile")} g
    JOIN season_weights w ON g.season = w.season
    GROUP BY g.player_id
  ),

  -- 4. BENCHMARKING (Percentiles Unificados)
  benchmarking AS (
    -- BLOQUE A: JUGADORES DE CAMPO
    SELECT 
      player_id, player_name, current_team_id, player_type,
      
      -- Métricas de Campo (Existen)
      w_goals_p30, w_xg_p30, w_shots_p30, w_key_passes_p30, 
      w_progressive_p30, w_dribble_pct, w_interceptions_p30, w_recoveries_p30,
      
      -- Métricas de Portero (No existen -> NULL)
      CAST(NULL as FLOAT64) as w_saves_vol,
      CAST(NULL as FLOAT64) as w_reflex_saves,
      CAST(NULL as FLOAT64) as w_long_dist_share,
      CAST(NULL as FLOAT64) as w_dist_accuracy,

      -- Percentiles Calculados (Campo)
      PERCENT_RANK() OVER (PARTITION BY player_type ORDER BY w_xg_p30 ASC) as pct_xg,
      PERCENT_RANK() OVER (PARTITION BY player_type ORDER BY w_goals_p30 ASC) as pct_goals,
      PERCENT_RANK() OVER (PARTITION BY player_type ORDER BY w_shots_p30 ASC) as pct_shots,
      PERCENT_RANK() OVER (PARTITION BY player_type ORDER BY w_key_passes_p30 ASC) as pct_creation,
      PERCENT_RANK() OVER (PARTITION BY player_type ORDER BY w_progressive_p30 ASC) as pct_progression,
      PERCENT_RANK() OVER (PARTITION BY player_type ORDER BY w_interceptions_p30 ASC) as pct_defense,
      PERCENT_RANK() OVER (PARTITION BY player_type ORDER BY w_recoveries_p30 ASC) as pct_workrate,
      
      -- Percentiles GK (NULL)
      CAST(NULL as FLOAT64) as pct_saves,
      CAST(NULL as FLOAT64) as pct_distribution
    FROM field_weighted

    UNION ALL

    -- BLOQUE B: PORTEROS
    SELECT 
      player_id, player_name, current_team_id, player_type,
      
      -- Métricas de Campo (NULL)
      NULL, NULL, NULL, NULL, 
      NULL, NULL, NULL, NULL,
      
      -- Métricas de Portero (Existen)
      w_saves_vol, w_reflex_saves, w_long_dist_share, w_dist_accuracy,

      -- Percentiles Campo (NULL)
      NULL, NULL, NULL, NULL, NULL, NULL, NULL,
      
      -- Percentiles Calculados (GK)
      PERCENT_RANK() OVER (PARTITION BY player_type ORDER BY w_reflex_saves ASC) as pct_saves,
      PERCENT_RANK() OVER (PARTITION BY player_type ORDER BY w_dist_accuracy ASC) as pct_distribution
    FROM gk_weighted
  )

SELECT 
  *
FROM benchmarking