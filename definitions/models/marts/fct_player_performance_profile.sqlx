config {
  type: "table"
  , schema: "marts_football"
  , description: "Tabla maestra de perfiles de rendimiento. Agregación por temporada y contexto (Game State) con métricas estadísticas (Media/StdDev) y relativas (Share)."
  , tags: ["marts"]
  , bigquery: {
      clusterBy: ["player_id", "season", "game_state_label"]
  }
}

with

  -- 1. Agregación por JUGADOR (Numeradores y Estadísticos)
  player_stats as (
    select
      int_player_match_stats.player_id
      , int_player_match_stats.player_name
      , int_player_match_stats.season
      , int_player_match_stats.league
      , int_player_match_stats.game_state_label
      , any_value(int_player_match_stats.team_id) as team_id
      , count(distinct int_player_match_stats.match_id) as matches_played
      , sum(int_player_match_stats.minutes_in_state_approx) as total_minutes_in_state

      -- MÉTRICAS P90 (Media y Desviación para Z-Score)
      -- Goles
      , avg(int_player_match_stats.goals_p90) as avg_goals_p90
      , stddev(int_player_match_stats.goals_p90) as std_goals_p90
      
      -- Tiros
      , avg(int_player_match_stats.shots_p90) as avg_shots_p90
      , stddev(int_player_match_stats.shots_p90) as std_shots_p90
      
      -- Regates
      , avg(int_player_match_stats.dribbles_p90) as avg_dribbles_p90
      , stddev(int_player_match_stats.dribbles_p90) as std_dribbles_p90
      
      -- Recuperaciones
      , avg(int_player_match_stats.recoveries_p90) as avg_recoveries_p90
      , stddev(int_player_match_stats.recoveries_p90) as std_recoveries_p90

      -- Eficiencia (Promedio de la precisión por partido)
      , avg(int_player_match_stats.pass_accuracy) as avg_pass_accuracy
      , stddev(int_player_match_stats.pass_accuracy) as std_pass_accuracy

      -- TOTALES ABSOLUTOS (Para cálculo de Shares)
      , sum(int_player_match_stats.goals) as total_goals
      , sum(int_player_match_stats.total_shots) as total_shots
      , sum(int_player_match_stats.total_passes) as total_passes
      , sum(int_player_match_stats.successful_passes) as total_successful_passes

    from
      ${ref("int_player_match_stats")} as int_player_match_stats
    group by
      int_player_match_stats.player_id
      , int_player_match_stats.player_name
      , int_player_match_stats.season
      , int_player_match_stats.league
      , int_player_match_stats.game_state_label
  )

  -- 2. Agregación por EQUIPO (Denominadores)
  , team_stats as (
    select
      int_player_match_stats.team_id
      , int_player_match_stats.season
      , int_player_match_stats.game_state_label
      , sum(int_player_match_stats.goals) as team_total_goals
      , sum(int_player_match_stats.total_shots) as team_total_shots
      , sum(int_player_match_stats.total_passes) as team_total_passes
    from
      ${ref("int_player_match_stats")} as int_player_match_stats
    group by
      int_player_match_stats.team_id
      , int_player_match_stats.season
      , int_player_match_stats.game_state_label
  )

  -- 3. Cruce Final (Perfiles + Relatividad)
  , final as (
    select
      -- Identificadores
      player_stats.player_id
      , player_stats.player_name
      , player_stats.season
      , player_stats.league
      , player_stats.game_state_label
      , player_stats.team_id
      , player_stats.matches_played
      , player_stats.total_minutes_in_state

      -- Estadísticos P90 (Input para Z-Score)
      , player_stats.avg_goals_p90
      , player_stats.std_goals_p90
      , player_stats.avg_shots_p90
      , player_stats.std_shots_p90
      , player_stats.avg_dribbles_p90
      , player_stats.std_dribbles_p90
      , player_stats.avg_recoveries_p90
      , player_stats.std_recoveries_p90
      , player_stats.avg_pass_accuracy
      , player_stats.std_pass_accuracy

      -- Métricas Relativas (Share of Team)
      , safe_divide(player_stats.total_goals, team_stats.team_total_goals) as share_of_team_goals
      , safe_divide(player_stats.total_shots, team_stats.team_total_shots) as share_of_team_shots
      , safe_divide(player_stats.total_passes, team_stats.team_total_passes) as share_of_team_passes
      
      -- Ratios Globales de Temporada
      , safe_divide(player_stats.total_goals, player_stats.total_shots) as global_conversion_rate

    from
      player_stats
      left join team_stats
        on player_stats.team_id = team_stats.team_id
        and player_stats.season = team_stats.season
        and player_stats.game_state_label = team_stats.game_state_label
  )

select * from final