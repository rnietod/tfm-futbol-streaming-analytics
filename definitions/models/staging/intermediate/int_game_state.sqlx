config {
  type: "view"
  , schema: "staging_football"
  , description: "Tabla intermedia que calcula el estado del marcador (Ganando/Perdiendo/Empatando) evento a evento."
  , tags: ["intermediate"]
  , assertions: {
      uniqueKey: ["event_key"]
  }
}

with

  events as (
    select 
      match_id
      , event_id
      , event_key
      , event_index_in_match
      , team_id
      , period_id
      , minute
      , second
      -- Detectar si es gol (Type 16 + Outcome 1)
      , case when type_id = 16 and outcome = 1 then 1 else 0 end as is_goal
    from ${ref("stg_events")}
    where type_id != 43
  )

  -- Calcular marcador acumulado (Running Total)
  , score_running as (
    select
      events.match_id
      , events.event_id
      , events.event_key
      , events.team_id
      , events.event_index_in_match
      
      -- Goles acumulados de ESTE equipo hasta este evento
      , sum(events.is_goal) over (
          partition by events.match_id, events.team_id 
          order by events.event_index_in_match 
          rows between unbounded preceding and current row
        ) as current_team_score
      
      -- Goles totales del PARTIDO hasta este evento
      , sum(events.is_goal) over (
          partition by events.match_id 
          order by events.event_index_in_match 
          rows between unbounded preceding and current row
        ) as current_match_score
    from 
      events
  )

  -- Determinar estado (Ganando/Perdiendo)
  , game_state as (
    select
      score_running.match_id
      , score_running.event_id
      , score_running.event_key
      , score_running.current_team_score
      , (score_running.current_match_score - score_running.current_team_score) as current_opponent_score
      
      , case
          when score_running.current_team_score > (score_running.current_match_score - score_running.current_team_score) then 'Winning'
          when score_running.current_team_score < (score_running.current_match_score - score_running.current_team_score) then 'Losing'
          else 'Drawing'
        end as game_state_label
        
    from 
      score_running
  )

select 
  match_id
  , event_id
  , event_key
  , current_team_score
  , current_opponent_score
  , game_state_label 
from 
  game_state

qualify row_number() over (partition by event_key order by current_team_score desc) = 1